{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIVLegacy/xivl-tools/schemas/conformance-case.schema.json",
  "title": "xivl-tools conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "formatId", "operation", "fixture", "expect"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "formatId": { "$ref": "#/$defs/id" },
    "operation": {
      "enum": ["inspect", "validate", "extract", "resource-path", "lua-path"]
    },
    "fixture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "public" },
            "path": {
              "type": "string",
              "pattern": "^tests/fixtures/public/[A-Za-z0-9._/-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fixtureId"],
          "properties": {
            "kind": { "const": "private" },
            "fixtureId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "arguments": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Command arguments after the operation and input. No absolute or workspace-relative path is permitted here."
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ok", "parse-error"] },
        "output": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.json$",
          "description": "Expected normalized output, resolved next to this manifest."
        },
        "errorKind": {
          "type": "string",
          "minLength": 1,
          "description": "Stable error identifier the tool must report for a malformed-input case."
        },
        "errorOffset": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional absolute byte offset asserted alongside errorKind."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "ok" } } },
          "then": { "required": ["output"] }
        },
        {
          "if": { "properties": { "outcome": { "const": "parse-error" } } },
          "then": { "required": ["errorKind"] }
        }
      ]
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48
    }
  }
}
